{
  "name": "animke-desktop",
  "productName": "Animke",
  "version": "1.4.0",
  "description": "Animke için Windows masaüstü uygulaması",
  "author": "Animke",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.animke.desktop",
    "productName": "Animke",
    "copyright": "Animke",
    "protocols": [
      {
        "name": "Animke",
        "schemes": [
          "animke"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Animke",
      "artifactName": "Animke-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iEmre1",
        "repo": "animke-desktop",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.3",
    "electron-updater": "6.8.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iEmre1/animke-desktop.git"
  },
  "homepage": "https://animke.com/indir"
}
